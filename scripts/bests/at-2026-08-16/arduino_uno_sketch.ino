//      0.816066,   0.706955,   0.610091,  0.522990,
//      0.443838,   0.372456]
//
// Again, only the first four gains are used in the successful
// 4-state feedback architecture.
const float K_R30_THETA = -214.138525f;
const float K_R30_THETA_DOT = -25.565794f;
const float K_R30_WHEEL_ANGLE = -0.518734f;  // position hold, see UPDATE 3
const float K_R30_WHEEL_SPEED = -3.138217f;

// Previous command is used ONLY for diagnostics (dU logging).
// It does not affect the controller.
float previousCommandForLog = 0.0f;

// Original delay-state gain names kept for compatibility/debug reference.
// The z states remain active inside the observer/model, but are not directly
// fed back into u_WheelAngleSpeed.
float gainZ1 = 0.906499f;
float gainZ2 = 0.785472f;
float gainZ3 = 0.676866f;
float gainZ4 = 0.577751f;
float gainZ5 = 0.486363f;
float gainZ6 = 0.403040f;

// ------------------------------------------------------------
// Dead-zone compensation
// ------------------------------------------------------------
// Measured on 2026-08-16 (scripts/motor-calibration/km-identification):
// with the wheels free, wheel A does not turn at all below a duty of about
// 0.25 and wheel B below about 0.35.  The balance loop puts out roughly
// 0.025 * u, so anything under about 2 degrees of tilt commands a duty that
// moves nothing.  The controller then has to wait for the error to grow
// before the wheels respond at all, which is the most likely source of the
// "gikogiko" chattering.
//
// The compensation adds the breakaway duty back on, so that a small command
// produces a small but non-zero motion:
//
//     duty = sign(u) * (DEADZONE * FRACTION + |u|)
//
// FRACTION deliberately under-compensates.  Inverting a dead zone exactly
// puts a jump of DEADZONE at every zero crossing, and over-compensating
// turns that jump into its own limit cycle.
//
// Set ENABLE_DEADZONE_COMPENSATION to false for a clean A/B against the
// previous behavior.
const bool ENABLE_DEADZONE_COMPENSATION = true;

const float DEADZONE_A = 0.25f;
const float DEADZONE_B = 0.35f;
const float DEADZONE_FRACTION = 0.8f;

// Commands below this are treated as zero, so that sensor noise around the
// upright point cannot rattle the output between +DEADZONE and -DEADZONE.
const float DEADZONE_MIN_COMMAND = 0.002f;

float compensateDeadZone(float duty, float deadzone) {
  if (!ENABLE_DEADZONE_COMPENSATION) {
    return duty;
  }

  if (abs(duty) < DEADZONE_MIN_COMMAND) {
    return 0.0f;
  }

  const float offset = deadzone * DEADZONE_FRACTION;
  return duty + (duty > 0.0f ? offset : -offset);
}

